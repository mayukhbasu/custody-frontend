{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "analytics/Module": ["analytics/src/remote-entry.ts"],
      "audit/Module": ["audit/src/remote-entry.ts"],
      "corporateaction/Module": ["corporateaction/src/remote-entry.ts"],
      "notification/Module": ["notification/src/remote-entry.ts"],
      "reconciliation/Module": ["reconciliation/src/remote-entry.ts"],
      "sla/Module": ["sla/src/remote-entry.ts"],
      "user/Module": ["user/src/remote-entry.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
